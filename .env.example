# KONTOGRAPH — copy to .env and adjust. Every setting maps to a field on
# kg_core.config.Settings; the KG_ prefix is what binds them.
#
#   cp .env.example .env      (bash)
#   Copy-Item .env.example .env   (PowerShell)
#
# .env is gitignored. Nothing secret belongs in .env.example.

# ---------------------------------------------------------------- runtime --
KG_ENV=local
KG_LOG_LEVEL=INFO
KG_LOG_FORMAT=console

# Determinism. Changing the seed changes the dataset fingerprint, which changes
# the identity of every downstream artifact — that is intended, not a bug.
# The default is the date SEPA Instant became mandatory in the euro area.
KG_SEED=20251009

# -------------------------------------------------------------- streaming --
KG_KAFKA_BOOTSTRAP=localhost:19092
KG_SCHEMA_REGISTRY_URL=http://localhost:18081

# -------------------------------------------------------------- lakehouse --
KG_S3_ENDPOINT=http://localhost:9000
KG_S3_ACCESS_KEY=kontograph
KG_S3_SECRET_KEY=kontograph
KG_S3_BUCKET=kontograph

# ------------------------------------------------------------------ redis --
KG_REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------------- mlflow --
KG_MLFLOW_TRACKING_URI=http://localhost:5000
KG_MLFLOW_EXPERIMENT=kontograph

# ---------------------------------------------------------------- serving --
# The SLA is configuration, not prose: the load test reads this and fails the
# build when p99 exceeds it (design principle P4).
KG_SLA_P99_MILLIS=200
KG_ALERT_THRESHOLD=0.5

# The k in precision@k. Set to the compliance team's real daily capacity.
KG_ANALYST_CAPACITY_PER_DAY=200

# ----------------------------------------------------------------- kaggle --
# Only needed for GPU training. Credentials come from ~/.kaggle/kaggle.json,
# never from this file.
KG_KAGGLE_USERNAME=
KG_KAGGLE_DATASET_SLUG=kontograph-sctinst
